data-sources/drivebc/historical/*.parquet

# Generated AQMap PM2.5 vector tiles are an experimental loose-file output.
# The app uses the native vector snapshot and archived raster tiles instead.
datascrapers/eccc/output/modelled-pm25-vector-tiles/

# Generated BC DB boundary chunks are large and should be published to object storage.
datascrapers/census/output/bc-db-chunks/

# Generated simplified canada-csd overview is derived from the committed
# full-detail snapshot at build time (census:canada-csd-simplified).
datascrapers/census/output/canada-csd-simplified.geojson

# Generated TELUS network vector tiles are local scraper output.
datascrapers/network/telus/output/tiles/

# Generated BCEnviroScreen/raw-data rebuild outputs stay local and can be rebuilt.
datascrapers/environmental-burden/output/
datascrapers/census/output/bcenviroscreen-census-lha/
datascrapers/health/bccdc-chronic-disease-tableau/output/

# Raw provincial Freshwater Atlas archives are multi-gigabyte source downloads.
datascrapers/bc/boundaries/source/BCFWA/*.zip
datascrapers/bc/boundaries/source/BCFWA/*.part
datascrapers/bc/boundaries/source/BCFWA/*_province_full.geojson
datascrapers/health/phsa-community-health/output/

# Flood Study Explorer is licensed "Access Only". Keep queried polygons and
# third-party report packages as a local research cache, not redistributed git data.
datascrapers/bc/flood/studies/cache/

# BC Hazard Insights / DCRRA services are licensed "Access Only". Downloads
# are a local research cache and must not be committed or redistributed unless
# written permission from the Province has been recorded.
datascrapers/bc/hazard-insights/cache/

# ClimateData.ca source rasters and derived HDF5 packs are multi-gigabyte local
# assessment/build artifacts. Keep the maintained inventory and converters only.
datascrapers/climate/climatedata-ca/cache/
