{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://data.map.ahmad.sh/schemas/bc-enviro-screen/release-manifest-v1.json",
  "title": "BC EnviroScreen Reconstruction release manifest",
  "type": "object",
  "required": ["schemaVersion", "releaseId", "methodVersion", "boundary", "indicatorKeys", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "releaseId": {"type": "string", "pattern": "^v[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}$"},
    "methodVersion": {"const": "bcenviroscreen-reconstruction-v1"},
    "boundary": {"type": "object"},
    "indicatorKeys": {"type": "array", "minItems": 21, "maxItems": 21, "uniqueItems": true},
    "files": {"type": "array", "minItems": 6}
  }
}
